{
  "name": "@concord/desktop",
  "private": true,
  "version": "0.1.7",
  "description": "Concord desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.15.3"
  },
  "author": "Raniery Fialho",
  "build": {
    "appId": "br.com.rafiweb.concord",
    "productName": "Concord",
    "artifactName": "Concord-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "icon": "icon.png",
    "publish": [
      {
        "provider": "generic",
        "url": "https://concord.rafiweb.com.br/downloads"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "linux-audio.js",
      "games.js",
      "rpc.js",
      "overlay.js",
      "overlay.html",
      "splash.html",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;InstantMessaging",
      "maintainer": "Raniery Fialho <noreply@rafiweb.com.br>",
      "executableName": "concord",
      "icon": "build/icons"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "pulseaudio-utils"
      ]
    }
  },
  "homepage": "https://concord.rafiweb.com.br",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
