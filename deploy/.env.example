# Domain pointing (DNS A record) to this server.
CONCORD_DOMAIN=chat.example.com

# Hostname clients use for TURN (voice relay). Must resolve straight to this server's IP:
# if your DNS is on Cloudflare, use a separate record with the proxy OFF (grey cloud), e.g. turn.example.com.
TURN_HOST=turn.example.com

# Shared secret between Concord and coturn. Generate with: openssl rand -hex 32
TURN_SECRET=troque-por-um-segredo-longo

# --- Only for docker-compose.npm.yml (behind an existing Nginx Proxy Manager) ---
# Network shared only by NPM and Concord (keeps Concord away from the other containers):
#   docker network create concord-proxy && docker network connect concord-proxy nginx-proxy-manager
NPM_NETWORK=concord-proxy
# Resource caps so transcription doesn't slow down the other sites.
CONCORD_CPUS=2
CONCORD_MEMORY=3g

# --- Optional: LiveKit SFU (for voice channels with many people) ---
# Uncomment, point a second DNS record to this server and run with `--profile livekit`.
# LIVEKIT_DOMAIN=livekit.example.com
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=concord
# LIVEKIT_API_SECRET=gere-com-openssl-rand-hex-32
